<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>VoltAI Pro | المهندس الذكي</title>
    
    <!-- PWA Requirements -->
    <link rel="manifest" href="data:application/manifest+json,{%22name%22:%22VoltAI%20Pro%22,%22short_name%22:%22VoltAI%22,%22start_url%22:%22./%22,%22display%22:%22standalone%22,%22background_color%22:%22%23080c14%22,%22theme_color%22:%22%233b82f6%22,%22icons%22:[{%22src%22:%22https://cdn-icons-png.flaticon.com/512/3063/3063822.png%22,%22sizes%22:%22512x512%22,%22type%22:%22image/png%22}]}"/>
    <meta name="theme-color" content="#080c14">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
        :root[data-theme="dark"] {
            --bg-color: #080c14;
            --card-bg: #111827;
            --card-border: #1f2937;
            --accent-color: #3b82f6;
            --accent-glow: rgba(59, 130, 246, 0.2);
            --text-main: #f9fafb;
            --text-muted: #9ca3af;
            --input-bg: #030712;
            --nav-bg: rgba(17, 24, 39, 0.85);
            --success-color: #10b981;
            --danger-color: #ef4444;
        }

        :root[data-theme="light"] {
            --bg-color: #f3f4f6;
            --card-bg: #ffffff;
            --card-border: #e5e7eb;
            --accent-color: #2563eb;
            --accent-glow: rgba(37, 99, 235, 0.15);
            --text-main: #111827;
            --text-muted: #4b5563;
            --input-bg: #f9fafb;
            --nav-bg: rgba(255, 255, 255, 0.9);
            --success-color: #059669;
            --danger-color: #dc2626;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
        body { background: var(--bg-color); color: var(--text-main); min-height: 100vh; padding-bottom: 30px; }

        header {
            background: var(--nav-bg); backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--card-border); padding: 12px 20px;
            position: sticky; top: 0; z-index: 100;
            display: flex; justify-content: space-between; align-items: center;
        }

        .logo-text { font-size: 1.15rem; font-weight: 800; color: var(--text-main); }
        .logo-accent { color: var(--accent-color); }
        .header-actions { display: flex; gap: 8px; }
        .icon-btn {
            background: var(--input-bg); border: 1px solid var(--card-border);
            color: var(--text-main); width: 38px; height: 38px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none;
        }

        .tab-bar {
            display: flex; background: var(--card-bg); border-bottom: 1px solid var(--card-border);
            overflow-x: auto; scrollbar-width: none; padding: 8px 12px; gap: 8px;
        }
        .tab-bar::-webkit-scrollbar { display: none; }

        .tab-btn {
            padding: 8px 14px; border-radius: 10px; border: 1px solid transparent;
            background: transparent; color: var(--text-muted); font-size: 0.85rem; font-weight: 600;
            white-space: nowrap; cursor: pointer; display: flex; align-items: center; gap: 6px;
        }
        .tab-btn.active { background: var(--accent-glow); border-color: var(--accent-color); color: var(--accent-color); }

        main { max-width: 900px; margin: 0 auto; padding: 16px; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .card {
            background: var(--card-bg); border: 1px solid var(--card-border);
            border-radius: 14px; padding: 18px; margin-bottom: 16px;
        }
        .card-title {
            font-size: 1rem; font-weight: 700; color: var(--accent-color);
            margin-bottom: 12px; border-bottom: 1px dashed var(--card-border); padding-bottom: 8px;
        }

        .form-group { margin-bottom: 12px; }
        label { display: block; font-size: 0.82rem; color: var(--text-muted); margin-bottom: 4px; }
        input, select, textarea {
            width: 100%; padding: 10px; background: var(--input-bg);
            border: 1px solid var(--card-border); border-radius: 8px; color: var(--text-main); outline: none;
        }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        @media(max-width: 600px){ .grid-2 { grid-template-columns: 1fr; } }

        button {
            width: 100%; background: var(--accent-color); color: #fff; border: none;
            padding: 10px; border-radius: 8px; font-weight: 700; cursor: pointer;
        }
        .result-box {
            background: var(--input-bg); border: 1px solid var(--card-border);
            border-radius: 8px; padding: 12px; margin-top: 12px; font-size: 0.88rem;
        }
        pre { white-space: pre-wrap; font-family: monospace; color: #38bdf8; direction: ltr; text-align: left; }
        .io-table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 0.8rem; }
        .io-table th, .io-table td { border: 1px solid var(--card-border); padding: 6px; text-align: right; }
    </style>
</head>
<body>

    <header>
        <div class="logo-text">VoltAI Pro | <span class="logo-accent">المهندس</span></div>
        <div class="header-actions">
            <a href="https://t.me/mzr_iq" target="_blank" class="icon-btn">✈️</a>
            <button class="icon-btn" onclick="toggleTheme()">🌙</button>
        </div>
    </header>

    <div class="tab-bar">
        <button class="tab-btn active" onclick="switchTab('t_ladder')">📄 منطق Ladder</button>
        <button class="tab-btn" onclick="switchTab('t_stardelta')">⚙️ ستار - دلتا</button>
        <button class="tab-btn" onclick="switchTab('t_sensor')">🎛️ محاكي الحساسات</button>
        <button class="tab-btn" onclick="switchTab('t_power')">⚡ القوى والأرضي</button>
        <button class="tab-btn" onclick="switchTab('t_plc_diag')">🚨 أعطال الـ PLC</button>
    </div>

    <main>
        <!-- TAB 1: LADDER -->
        <div id="t_ladder" class="tab-content active">
            <div class="card">
                <div class="card-title">🤖 مولد مخططات وعناوين الـ Ladder Diagram</div>
                <div class="form-group">
                    <label>معيار عناوين الـ PLC:</label>
                    <select id="ladderStandard">
                        <option value="siemens">Siemens Standard (I0.0 / Q0.0)</option>
                        <option value="allen">Allen-Bradley Standard (I:1/0 / O:2/0)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>وصف دائرة التحكم المطلوبة:</label>
                    <input type="text" id="ladderPrompt" placeholder="مثال: دائرة تشغيل وإيقاف محرك مع تايمر وحماية أوفرلود">
                </div>
                <button onclick="generateLadderDiagram()">توليد المخطط والعناوين ⚡</button>
                <div id="ladderResult" class="result-box" style="display:none;"></div>
            </div>
        </div>

        <!-- TAB 2: STAR DELTA -->
        <div id="t_stardelta" class="tab-content">
            <div class="card">
                <div class="card-title">⚙️ مصمم دائرة ستار - دلتا (Star-Delta Starter)</div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>قدرة المحرك:</label>
                        <input type="number" id="sdPower" placeholder="مثال: 30">
                    </div>
                    <div class="form-group">
                        <label>الوحدة:</label>
                        <select id="sdUnit">
                            <option value="kw">kW</option>
                            <option value="hp">HP</option>
                        </select>
                    </div>
                </div>
                <button onclick="generateStarDelta()">حساب القطع والتوقيت ⚡</button>
                <div id="sdResult" class="result-box" style="display:none;"></div>
            </div>
        </div>

        <!-- TAB 3: SENSORS -->
        <div id="t_sensor" class="tab-content">
            <div class="card">
                <div class="card-title">🎛️ محاكي إشارات الحساسات (4-20mA & 0-10V)</div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>نوع الإشارة:</label>
                        <select id="signalType">
                            <option value="current">4 - 20 mA</option>
                            <option value="voltage">0 - 10 V</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>القيمة المقروءة:</label>
                        <input type="number" id="signalValue" step="0.1" placeholder="مثال: 12 mA">
                    </div>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>الحد الأدنى (Min):</label>
                        <input type="number" id="sensorMin" value="0">
                    </div>
                    <div class="form-group">
                        <label>الحد الأقصى (Max):</label>
                        <input type="number" id="sensorMax" value="10">
                    </div>
                </div>
                <button onclick="calculateSensorSignal()">حساب القيمة الهندسية</button>
                <div id="signalResult" class="result-box" style="display:none;"></div>
            </div>
        </div>

        <!-- TAB 4: POWER & EARTHING -->
        <div id="t_power" class="tab-content">
            <div class="card">
                <div class="card-title">⚡ حاسبة سعة المولدات ومقاومة التأريض</div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>أحمال المبنى (kW):</label>
                        <input type="number" id="genLoadKw" placeholder="مثال: 80">
                    </div>
                    <div class="form-group">
                        <label>أكبر محرك بالمبنى (HP):</label>
                        <input type="number" id="genMaxMotor" placeholder="مثال: 25">
                    </div>
                </div>
                <button onclick="calculateGenAndEarthing()">حساب سعة المولد والأرضي</button>
                <div id="genResult" class="result-box" style="display:none;"></div>
            </div>
        </div>

        <!-- TAB 5: PLC DIAGNOSTICS -->
        <div id="t_plc_diag" class="tab-content">
            <div class="card">
                <div class="card-title">🚨 دليل تشخيص أعطال لمبات الـ PLC</div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>المصنع:</label>
                        <select id="plcBrand">
                            <option value="siemens">Siemens S7</option>
                            <option value="schneider">Schneider Modicon</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>حالة اللمبة:</label>
                        <select id="plcLed">
                            <option value="sf_red">SF حمراء ثابتة</option>
                            <option value="bf_blink">BF حمراء ترمش</option>
                        </select>
                    </div>
                </div>
                <button onclick="diagnosePlc()">فحص السبب الميداني والحل 🔍</button>
                <div id="plcLedResult" class="result-box" style="display:none;"></div>
            </div>
        </div>
    </main>

    <script>
        function switchTab(tId) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            event.currentTarget.classList.add('active');
            document.getElementById(tId).classList.add('active');
        }

        function toggleTheme() {
            const cur = document.documentElement.getAttribute('data-theme');
            document.documentElement.setAttribute('data-theme', cur === 'dark' ? 'light' : 'dark');
        }

        function generateLadderDiagram() {
            const p = document.getElementById('ladderPrompt').value || 'تشغيل محرك';
            const std = document.getElementById('ladderStandard').value;
            const res = document.getElementById('ladderResult');
            const isS = std === 'siemens';
            
            res.style.display = 'block';
            res.innerHTML = `
                <strong>جدول العناوين (I/O Table):</strong>
                <table class="io-table">
                    <tr><th>العنوان</th><th>العنصر</th></tr>
                    <tr><td>${isS?'I0.0':'I:1/0'}</td><td>زر إيقاف NC</td></tr>
                    <tr><td>${isS?'I0.1':'I:1/1'}</td><td>زر تشغيل NO</td></tr>
                    <tr><td>${isS?'Q0.0':'O:2/0'}</td><td>مخرج المحرك</td></tr>
                </table>
                <h4 style="margin-top:8px;">مخطط Ladder:</h4>
                <pre>---|/|-------| |-------( )---
 (Stop)    (Start)   (Motor)</pre>
            `;
        }

        function generateStarDelta() {
            const p = parseFloat(document.getElementById('sdPower').value);
            const u = document.getElementById('sdUnit').value;
            const res = document.getElementById('sdResult');
            if(!p) return;
            const kw = u === 'hp' ? p * 0.746 : p;
            const flc = (kw * 1000) / (1.732 * 380 * 0.85 * 0.88);
            res.style.display = 'block';
            res.innerHTML = `
                - تيار FLC: <strong>${flc.toFixed(1)} A</strong><br>
                - كونتاكتور الرئيسية والدلتا: <strong>${Math.ceil(flc * 0.58)} A</strong><br>
                - كونتاكتور الستار: <strong>${Math.ceil(flc * 0.33)} A</strong><br>
                - ضبط الأوفرلود: <strong>${(flc * 0.58).toFixed(1)} A</strong>
            `;
        }

        function calculateSensorSignal() {
            const t = document.getElementById('signalType').value;
            const v = parseFloat(document.getElementById('signalValue').value);
            const min = parseFloat(document.getElementById('sensorMin').value);
            const max = parseFloat(document.getElementById('sensorMax').value);
            const res = document.getElementById('signalResult');
            if(isNaN(v)) return;
            let pct = t === 'current' ? ((v-4)/16)*100 : (v/10)*100;
            pct = Math.max(0, Math.min(100, pct));
            const eng = min + ((pct/100)*(max-min));
            res.style.display = 'block';
            res.innerHTML = `النسبة: <strong>${pct.toFixed(1)}%</strong> | القيمة الهندسية: <strong>${eng.toFixed(2)}</strong>`;
        }

        function calculateGenAndEarthing() {
            const kw = parseFloat(document.getElementById('genLoadKw').value) || 0;
            const hp = parseFloat(document.getElementById('genMaxMotor').value) || 0;
            const res = document.getElementById('genResult');
            if(!kw) return;
            const kva = Math.ceil(((kw/0.8)*1.25) + ((hp*0.746/0.8)*2));
            res.style.display = 'block';
            res.innerHTML = `سعة المولد المقترحة: <strong>${kva} kVA</strong> | القاطع: <strong>${Math.ceil((kva*1000)/(1.732*380))} A</strong>`;
        }

        function diagnosePlc() {
            const res = document.getElementById('plcLedResult');
            res.style.display = 'block';
            res.innerHTML = `<strong>السبب:</strong> خطأ في التغذية أو انقطاع في سلك الإشارة. افحص خط الـ 24V DC والتوصيلات.`;
        }
    </script>
</body>
</html>
