<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>المهندس الذكي | VoltAI Pro</title>

    <!-- PWA & Web App Manifest -->
    <meta name="theme-color" content="#0b0f19">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="VoltAI">

    <!-- External Libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <style>
        :root[data-theme="dark"] {
            --bg-color: #080c14;
            --card-bg: #111827;
            --card-border: #1f2937;
            --accent-color: #3b82f6;
            --accent-hover: #2563eb;
            --accent-glow: rgba(59, 130, 246, 0.2);
            --text-main: #f9fafb;
            --text-muted: #9ca3af;
            --input-bg: #030712;
            --nav-bg: rgba(17, 24, 39, 0.85);
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.5);
        }

        :root[data-theme="light"] {
            --bg-color: #f3f4f6;
            --card-bg: #ffffff;
            --card-border: #e5e7eb;
            --accent-color: #2563eb;
            --accent-hover: #1d4ed8;
            --accent-glow: rgba(37, 99, 235, 0.15);
            --text-main: #111827;
            --text-muted: #4b5563;
            --input-bg: #f9fafb;
            --nav-bg: rgba(255, 255, 255, 0.9);
            --success-color: #059669;
            --warning-color: #d97706;
            --danger-color: #dc2626;
            --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding-bottom: 70px;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        body.torch-active {
            background-color: #ffffff !important;
            color: #000000 !important;
        }
        body.torch-active * { display: none !important; }
        body.torch-active #torchOverlay { display: flex !important; }

        #torchOverlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: #ffffff;
            z-index: 9999;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #000;
        }

        header {
            background: var(--nav-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--card-border);
            padding: 12px 20px;
            position: sticky;
            top: 0;
            z-index: 100;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-block {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-svg { width: 36px; height: 36px; }

        .logo-text {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.5px;
        }
        .logo-accent { color: var(--accent-color); }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .icon-btn {
            background: var(--input-bg);
            border: 1px solid var(--card-border);
            color: var(--text-main);
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .icon-btn:hover {
            border-color: var(--accent-color);
            box-shadow: 0 0 10px var(--accent-glow);
        }

        .svg-icon {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .ai-status-bar {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 8px 14px;
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .status-dot {
            width: 10px; height: 10px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 6px;
        }
        .status-connected { background-color: var(--success-color); box-shadow: 0 0 8px var(--success-color); }

        .tab-bar {
            display: flex;
            background: var(--card-bg);
            border-bottom: 1px solid var(--card-border);
            overflow-x: auto;
            scrollbar-width: none;
            padding: 8px 12px;
            gap: 8px;
        }
        .tab-bar::-webkit-scrollbar { display: none; }

        .tab-btn {
            padding: 8px 14px;
            border-radius: 12px;
            border: 1px solid transparent;
            background: transparent;
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 600;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.25s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .tab-btn.active {
            background: var(--accent-glow);
            border-color: var(--accent-color);
            color: var(--accent-color);
        }

        main {
            flex: 1;
            max-width: 920px;
            width: 100%;
            margin: 0 auto;
            padding: 16px;
        }

        .tab-content {
            display: none;
            animation: fadeIn 0.35s ease;
        }
        .tab-content.active { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 16px;
            box-shadow: var(--shadow);
        }

        .card-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--accent-color);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px dashed var(--card-border);
            padding-bottom: 10px;
        }

        .form-group { margin-bottom: 14px; }

        label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        input, select, textarea {
            width: 100%;
            padding: 12px 14px;
            background: var(--input-bg);
            border: 1px solid var(--card-border);
            border-radius: 10px;
            color: var(--text-main);
            font-size: 0.92rem;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        input:focus, select:focus, textarea:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 8px var(--accent-glow);
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        @media (max-width: 600px) { .grid-2 { grid-template-columns: 1fr; } }

        .btn-primary {
            width: 100%;
            background: var(--accent-color);
            color: #ffffff;
            border: none;
            padding: 12px 18px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
        }
        .btn-success { background: var(--success-color); }
        .btn-secondary { background: var(--input-bg); border: 1px solid var(--card-border); color: var(--text-main); }

        .result-box {
            background: var(--input-bg);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 16px;
            margin-top: 14px;
            font-size: 0.9rem;
            line-height: 1.6;
        }

        pre {
            white-space: pre-wrap;
            font-family: 'Courier New', Courier, monospace;
            color: var(--accent-color);
            direction: ltr;
            text-align: left;
            background: rgba(0, 0, 0, 0.25);
            padding: 12px;
            border-radius: 8px;
            margin-top: 8px;
            overflow-x: auto;
        }

        .timeline {
            position: relative;
            padding-right: 20px;
            border-right: 2px solid var(--card-border);
            margin-top: 10px;
        }
        .timeline-item {
            position: relative;
            margin-bottom: 14px;
            padding-right: 12px;
        }
        .timeline-item::before {
            content: '';
            position: absolute;
            right: -26px;
            top: 4px;
            width: 10px; height: 10px;
            border-radius: 50%;
            background: var(--accent-color);
            box-shadow: 0 0 8px var(--accent-glow);
        }

        .io-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            font-size: 0.85rem;
        }
        .io-table th, .io-table td {
            border: 1px solid var(--card-border);
            padding: 8px 12px;
            text-align: right;
        }
        .io-table th { background: rgba(59, 130, 246, 0.1); color: var(--accent-color); }

        footer {
            text-align: center;
            padding: 16px;
            font-size: 0.8rem;
            color: var(--text-muted);
            border-top: 1px solid var(--card-border);
            margin-top: auto;
        }
    </style>
</head>
<body>

    <div id="torchOverlay" onclick="toggleEmergencyTorch()">
        <h2>🔦 وضع الكشاف الشديد للطوارئ</h2>
        <p style="margin-top:10px;">انقر في أي مكان في الشاشة لإغلاق الكشاف</p>
    </div>

    <header>
        <div class="logo-block">
            <svg class="logo-svg" viewBox="0 0 100 100" fill="none">
                <circle cx="50" cy="50" r="48" stroke="#3b82f6" stroke-width="2" fill="#0b1120"/>
                <path d="M50 15L65 30H75L80 35V45L85 50L80 55V65L75 70H65L50 85L35 70H25L20 65V55L15 50L20 45V35L25 30H35L50 15Z" fill="#151d30" stroke="#3b82f6" stroke-width="2"/>
                <path d="M50 30L45 50H55L50 70L60 50H50L55 30" fill="#3b82f6" transform="translate(-2.5, 0)"/>
            </svg>
            <div class="logo-text">VoltAI Pro | <span class="logo-accent">المهندس</span></div>
        </div>
        <div class="header-actions">
            <button class="icon-btn" onclick="toggleEmergencyTorch()" title="كشاف طوارئ الشاشة">
                <svg class="svg-icon" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </button>
            <a href="https://t.me/mzr_iq" target="_blank" class="icon-btn" title="تواصل تلجرام">
                <svg class="svg-icon" viewBox="0 0 24 24" stroke="#0088cc"><path d="M21.5 2L2 11.5l7 3 3 7 3.5-4.5 5.5 4z"/><path d="M9 14.5L21.5 2"/></svg>
            </a>
            <button class="icon-btn" onclick="toggleTheme()" title="تغيير المظهر">
                <svg class="svg-icon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
            </button>
        </div>
    </header>

    <div class="tab-bar">
        <button class="tab-btn active" onclick="switchTab('ladder_sec')">
            <svg class="svg-icon" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
            منطق Ladder Diagram
        </button>
        <button class="tab-btn" onclick="switchTab('stardelta_sec')">
            <svg class="svg-icon" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            ستار - دلتا
        </button>
        <button class="tab-btn" onclick="switchTab('sensor_sec')">
            <svg class="svg-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/></svg>
            محاكي الحساسات
        </button>
        <button class="tab-btn" onclick="switchTab('power_sec')">
            <svg class="svg-icon" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/></svg>
            حسابات القوى والأرضي
        </button>
        <button class="tab-btn" onclick="switchTab('plc_diag_sec')">
            <svg class="svg-icon" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
            أعطال الـ PLC
        </button>
        <button class="tab-btn" onclick="switchTab('profile_sec')">
            <svg class="svg-icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            السجل والملف
        </button>
    </div>

    <main>
        <div class="ai-status-bar">
            <span>📡 حالة الاتصال بـ VoltAI (الرد الذكي):</span>
            <span style="color:var(--success-color);"><span class="status-dot status-connected"></span>🟡 متصل - جاهز للرد</span>
        </div>

        <!-- 1. LADDER LOGIC GENERATOR -->
        <div id="ladder_sec" class="tab-content active">
            <div class="card">
                <div class="card-title">🤖 مولد مخططات وعناوين الـ Ladder Diagram</div>
                <div class="form-group">
                    <label>معيار عناوين الـ PLC:</label>
                    <select id="ladderStandard">
                        <option value="siemens">Siemens Standard (I0.0 / Q0.0)</option>
                        <option value="allen">Allen-Bradley Standard (I:1/0 / O:2/0)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>وصف دائرة التحكم المطلوبة:</label>
                    <input type="text" id="ladderPrompt" placeholder="مثال: دائرة تشغيل وإيقاف محرك مع حماية أوفرلود وتأخير تايمر 5 ثوانٍ">
                </div>
                <button class="btn-primary" onclick="generateLadderDiagram()">توليد المخطط وتوزيع العناوين ⚡</button>
                <div id="ladderResult" class="result-box" style="display:none;"></div>
            </div>
        </div>

        <!-- 2. STAR DELTA GENERATOR -->
        <div id="stardelta_sec" class="tab-content">
            <div class="card">
                <div class="card-title">⚙️ مصمم ومولد دوائر ستار - دلتا (Star-Delta Starter)</div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>قدرة المحرك:</label>
                        <input type="number" id="sdPower" placeholder="مثال: 30">
                    </div>
                    <div class="form-group">
                        <label>الوحدة:</label>
                        <select id="sdUnit">
                            <option value="kw">كيلوواط (kW)</option>
                            <option value="hp">حصان (HP)</option>
                        </select>
                    </div>
                </div>
                <button class="btn-primary" onclick="generateStarDelta()">حساب القطع وتوليد المخطط ⚡</button>
                <div id="sdResult" class="result-box" style="display:none;"></div>
            </div>
        </div>

        <!-- 3. SENSOR SIMULATOR -->
        <div id="sensor_sec" class="tab-content">
            <div class="card">
                <div class="card-title">🎛️ محاكي ومولد إشارات الحساسات (4-20mA & 0-10V)</div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>نوع الإشارة التناظرية:</label>
                        <select id="signalType">
                            <option value="current">تيار قياسي (4 - 20 mA)</option>
                            <option value="voltage">جهد قياسي (0 - 10 V)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>القيمة المقروءة حالياً:</label>
                        <input type="number" id="signalValue" step="0.1" placeholder="مثال: 12 mA أو 5 V">
                    </div>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>الحد الأدنى للحساس (Min Range):</label>
                        <input type="number" id="sensorMin" value="0" placeholder="مثال: 0 Bar">
                    </div>
                    <div class="form-group">
                        <label>الحد الأقصى للحساس (Max Range):</label>
                        <input type="number" id="sensorMax" value="10" placeholder="مثال: 10 Bar">
                    </div>
                </div>
                <button class="btn-primary" onclick="calculateSensorSignal()">حساب النسبة والقيمة الهندسية</button>
                <div id="signalResult" class="result-box" style="display:none;"></div>
            </div>
        </div>

        <!-- 4. POWER & EARTHING -->
        <div id="power_sec" class="tab-content">
            <div class="card">
                <div class="card-title">⚡ حاسبة سعة المولدات ومقاومة أرضي الوقاية</div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>إجمالي أحمال المبنى (kW):</label>
                        <input type="number" id="genLoadKw" placeholder="مثال: 80">
                    </div>
                    <div class="form-group">
                        <label>أكبر محرك يعمل بالمبنى (HP):</label>
                        <input type="number" id="genMaxMotor" placeholder="مثال: 25">
                    </div>
                </div>
                <button class="btn-primary" onclick="calculateGeneratorAndEarthing()">حساب سعة المولد والأرضي 🧮</button>
                <div id="genResult" class="result-box" style="display:none;"></div>
            </div>
        </div>

        <!-- 5. PLC DIAGNOSTICS -->
        <div id="plc_diag_sec" class="tab-content">
            <div class="card">
                <div class="card-title">🚨 دليل تشخيص أعطال لمبات الـ PLC</div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>المصنع:</label>
                        <select id="plcBrandSelect">
                            <option value="siemens">Siemens (S7-1200 / S7-300)</option>
                            <option value="schneider">Schneider (Modicon / M221)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>حالة اللمبة:</label>
                        <select id="plcLedSelect">
                            <option value="sf_red">لمبة SF حمراء ثابتة</option>
                            <option value="bf_blink">لمبة BF حمراء ترمش</option>
                            <option value="stop_yellow">لمبة STOP برتقالية ثابتة</option>
                        </select>
                    </div>
                </div>
                <button class="btn-primary" onclick="diagnosePlcLed()">فحص السبب الميداني والحل 🔍</button>
                <div id="plcLedResult" class="result-box" style="display:none;"></div>
            </div>
        </div>

        <!-- 6. PROFILE & HISTORY -->
        <div id="profile_sec" class="tab-content">
            <div class="card">
                <div class="card-title">📜 سجل العمليات الأخير (Operation History Timeline)</div>
                <div id="historyList" class="timeline">لا يوجد سجل عمليات حالياً.</div>
            </div>
        </div>
    </main>

    <footer>
        جميع الحقوق محفوظة © 2026 | تطوير <a href="https://github.com/std24341059-max" target="_blank" style="color:var(--accent-color); font-weight:bold; text-decoration:none;">المهندس منتظر عون</a>
    </footer>

    <script>
        function toggleEmergencyTorch() { document.body.classList.toggle('torch-active'); }
        function toggleTheme() {
            const current = document.documentElement.getAttribute('data-theme');
            document.documentElement.setAttribute('data-theme', current === 'dark' ? 'light' : 'dark');
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            event.currentTarget.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }

        function saveHistory(action) {
            let history = JSON.parse(localStorage.getItem('voltAiHist')) || [];
            const time = new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
            history.unshift(`[${time}] ${action}`);
            if(history.length > 8) history.pop();
            localStorage.setItem('voltAiHist', JSON.stringify(history));
            renderHistory();
        }

        function renderHistory() {
            let history = JSON.parse(localStorage.getItem('voltAiHist')) || [];
            const container = document.getElementById('historyList');
            if(!container) return;
            if(history.length === 0) { container.innerHTML = 'لا يوجد سجل عمليات حالياً.'; return; }
            container.innerHTML = history.map(item => `
                <div class="timeline-item">
                    <strong style="color:var(--text-main); font-size:0.85rem;">${item}</strong>
                </div>
            `).join('');
        }

        function generateLadderDiagram() {
            const prompt = document.getElementById('ladderPrompt').value || 'دائرة تشغيل وإيقاف محرك';
            const std = document.getElementById('ladderStandard').value;
            const resDiv = document.getElementById('ladderResult');

            const isSiemens = std === 'siemens';
            const startAddr = isSiemens ? 'I0.0' : 'I:1/0';
            const stopAddr = isSiemens ? 'I0.1' : 'I:1/1';
            const olAddr = isSiemens ? 'I0.2' : 'I:1/2';
            const outAddr = isSiemens ? 'Q0.0' : 'O:2/0';

            resDiv.style.display = 'block';
            resDiv.innerHTML = `
                <strong>📋 جدول تخصيص العناوين (I/O Table):</strong>
                <table class="io-table">
                    <tr><th>العنوان البرمجي</th><th>العنصر الميداني</th><th>الحالة</th></tr>
                    <tr><td><strong>${stopAddr}</strong></td><td>زر إيقاف (Stop)</td><td>NC مغلق</td></tr>
                    <tr><td><strong>${olAddr}</strong></td><td>حماية أوفرلود (Overload)</td><td>NC مغلق</td></tr>
                    <tr><td><strong>${startAddr}</strong></td><td>زر تشغيل (Start)</td><td>NO مفتوح</td></tr>
                    <tr><td><strong>${outAddr}</strong></td><td>ملف المحرك (Motor Coil)</td><td>Output</td></tr>
                </table>

                <h4 style="margin-top:10px;">📐 مخطط الـ Ladder Diagram النصي:</h4>
                <pre>
NETWORK 1: ${prompt}
   ${stopAddr}         ${olAddr}         ${startAddr}        ${outAddr}
---|/|---------|/|---------| |---------( )---
 (Stop NC)   (Overload NC) (Start NO)   (Motor)
                               |
                             ${outAddr}
                            ---| |---
                             (Latch)
                </pre>
            `;
            saveHistory(`توليد Ladder: ${prompt}`);
        }

        function generateStarDelta() {
            const p = parseFloat(document.getElementById('sdPower').value);
            const unit = document.getElementById('sdUnit').value;
            const resDiv = document.getElementById('sdResult');

            if(!p) { alert('يرجى إدخال قدرة المحرك'); return; }

            const kw = (unit === 'hp') ? p * 0.746 : p;
            const flc = (kw * 1000) / (1.732 * 380 * 0.85 * 0.88);
            
            resDiv.style.display = 'block';
            resDiv.innerHTML = `
                <strong>حسابات دائرة ستار - دلتا (${p} ${unit}):</strong><br>
                - تيار الحمل الكامل (FLC): <strong>${flc.toFixed(1)} أمبير</strong><br>
                - كونتاكتور الرئيسي والداخلية (Main & Delta): <strong>${Math.ceil(flc * 0.58)} أمبير</strong><br>
                - كونتاكتور الستار (Star Contactor): <strong>${Math.ceil(flc * 0.33)} أمبير</strong><br>
                - عيار الأوفرلود (تحت الدلتا): <strong style="color:var(--success-color);">${(flc * 0.58).toFixed(1)} أمبير</strong>
            `;
            saveHistory(`حساب ستار-دلتا ${p}${unit}`);
        }

        function calculateSensorSignal() {
            const type = document.getElementById('signalType').value;
            const val = parseFloat(document.getElementById('signalValue').value);
            const min = parseFloat(document.getElementById('sensorMin').value);
            const max = parseFloat(document.getElementById('sensorMax').value);
            const resDiv = document.getElementById('signalResult');

            if(isNaN(val)) { alert('يرجى إدخال القيمة'); return; }

            let percentage = (type === 'current') ? ((val - 4) / 16) * 100 : (val / 10) * 100;
            percentage = Math.max(0, Math.min(100, percentage));
            const engVal = min + ((percentage / 100) * (max - min));

            resDiv.style.display = 'block';
            resDiv.innerHTML = `
                - نسبة الإشارة: <strong>${percentage.toFixed(1)}%</strong><br>
                - القيمة الهندسية المقابلة: <strong style="color:var(--accent-color);">${engVal.toFixed(2)} (من ${min} إلى ${max})</strong>
            `;
            saveHistory(`محاكاة حساس: ${val}`);
        }

        function calculateGeneratorAndEarthing() {
            const kw = parseFloat(document.getElementById('genLoadKw').value) || 0;
            const motorHp = parseFloat(document.getElementById('genMaxMotor').value) || 0;
            const resDiv = document.getElementById('genResult');

            if(!kw) { alert('أدخل أحمال المبنى'); return; }

            const recGenKva = Math.ceil(((kw / 0.8) * 1.25) + ((motorHp * 0.746 / 0.8) * 2));
            resDiv.style.display = 'block';
            resDiv.innerHTML = `
                - سعة المولد المقترحة لتغطية تيار البدء: <strong style="color:var(--accent-color);">${recGenKva} kVA</strong><br>
                - سعة القاطع الرئيسي: <strong>${Math.ceil((recGenKva * 1000)/(1.732 * 380))} A</strong>
            `;
            saveHistory(`حساب مولد ${kw}kW`);
        }

        function diagnosePlcLed() {
            const led = document.getElementById('plcLedSelect').value;
            const resDiv = document.getElementById('plcLedResult');
            resDiv.style.display = 'block';
            resDiv.innerHTML = `<strong>نتيجة التشخيص:</strong> عطل في الربط الميداني أو خطأ في عنوان الـ I/O. افحص تغذية الـ 24V DC وتوافق العناوين.`;
            saveHistory(`تشخيص لمبة PLC`);
        }

        window.onload = renderHistory;
    </script>
</body>
</html>
